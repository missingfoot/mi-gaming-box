<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Mi Gaming Box</vendor>
  <action id="io.github.missingfoot.migamingbox.helper">
    <description>Control the Mi Gaming Laptop's fans, lighting and keyboard</description>
    <message>Mi Gaming Box needs access to the laptop's firmware controls</message>
    <icon_name>migamingbox</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mi-gaming-box/migamingbox-helper</annotate>
  </action>
</policyconfig>
