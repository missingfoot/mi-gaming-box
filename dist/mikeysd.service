[Unit]
Description=Xiaomi Mi Gaming Laptop macro keys
After=systemd-modules-load.service
# Only start on the supported laptop (override with a drop-in if you know better).
ConditionFirmware=smbios-field(product_name = TM1801)

[Service]
ExecStartPre=-/usr/bin/modprobe acpi_call
ExecStart=/usr/bin/mikeysd
Restart=on-failure
RestartSec=2
# /run/mi-gaming-box/keys.sock: the GUI listens here to run "command" actions as the user.
RuntimeDirectory=mi-gaming-box
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
