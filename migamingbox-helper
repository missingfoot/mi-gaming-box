#!/usr/bin/env python3
"""Root helper for the GUI, started through pkexec.

polkit authorises it via com.jamessparkes.migamingbox.helper, which matches
this file's installed path (/usr/lib/mi-gaming-box/migamingbox-helper).

Thin launcher: the code lives in migamingboxlib/ next to this script (dev
checkout) or in /usr/lib/mi-gaming-box/ (installed package, see PKGBUILD)."""

import sys
from pathlib import Path

_here = Path(__file__).resolve().parent
for _candidate in (_here, Path("/usr/lib/mi-gaming-box")):
    if (_candidate / "migamingboxlib" / "__init__.py").exists():
        sys.path.insert(0, str(_candidate))
        break
else:
    raise ImportError("Could not locate the migamingboxlib package (looked in "
                      f"{_here} and /usr/lib/mi-gaming-box)")

from migamingboxlib.miwmi import serve

if __name__ == "__main__":
    serve()
